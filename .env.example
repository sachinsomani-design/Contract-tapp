# .env.example

# Copy this file to .env and fill in your values

GOOGLE_CLIENT_ID=your_client_id_from_google_cloud_console
GOOGLE_CLIENT_SECRET=your_client_secret_from_google_cloud_console
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback

# Email to send reminders to
REMINDER_EMAIL=legal@tractorjunction.com

# Database path
DATABASE_PATH=./contracts.db

# Server port
PORT=3000
